#!/bin/sh
# RaWaLLMConfig pre-push — Push-Checklisten-Enforcer (Leak-Response 2026-09-12).
# Versionierte Quelle: scripts/git-hooks/pre-push — Installation: pnpm hooks:install
# Erzwingt mechanisch die Checkliste aus PUSH-CHECKLISTE.md. Jeder Punkt wird
# geprueft und mit ✅/❌ ausgegeben; ein ❌ blockiert den Push.
# Bypass nur mit Owner-Go: git push --no-verify
#
# Policy: scripts/git-hooks/public-push-policy.txt (getrackt, generisch)
#       + scripts/git-hooks/public-push-policy.local.txt (gitignored, persoenlich)

ROOT="$(git rev-parse --show-toplevel)"
POLICY="$ROOT/scripts/git-hooks/public-push-policy.txt"
POLICY_LOCAL="$ROOT/scripts/git-hooks/public-push-policy.local.txt"
ZERO="0000000000000000000000000000000000000000"
EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

PATHS_FILE="$(mktemp)"; PATTERNS_FILE="$(mktemp)"; POLICY_TMP=""
trap 'rm -f "$PATHS_FILE" "$PATTERNS_FILE" "$POLICY_TMP"' EXIT

# Policy aus dem Worktree; falls der ausgecheckte Stand sie nicht kennt,
# Fallback auf origin/main. Fehlt sie auch dort: fail-closed.
if [ ! -f "$POLICY" ]; then
  POLICY_TMP="$(mktemp)"
  git show origin/main:scripts/git-hooks/public-push-policy.txt > "$POLICY_TMP" 2>/dev/null \
    && POLICY="$POLICY_TMP" \
    || { echo "pre-push: Policy-Datei weder im Worktree noch auf origin/main — Push blockiert (fail-closed)." >&2; exit 1; }
fi

grep -h '^PATH:' "$POLICY" "$POLICY_LOCAL" 2>/dev/null | cut -d: -f2- > "$PATHS_FILE"
grep -h '^PATTERN:' "$POLICY" "$POLICY_LOCAL" 2>/dev/null | cut -d: -f2- > "$PATTERNS_FILE"
[ -f "$POLICY_LOCAL" ] && LOCAL_NOTE=" (+ lokale persoenliche Muster)"

# Regex fuer Tree-Pfade: ^(pfad1|pfad2|...)(/|$)
PATH_RE=$(awk '{ gsub(/\./, "\\."); printf "%s%s", (NR > 1 ? "|" : ""), $0 }' "$PATHS_FILE")

fails=""
report=""

# ── Punkt 4 (typecheck) laeuft einmal pro Push, nicht pro Ref ────────────────
if pnpm typecheck > /dev/null 2>&1; then
  report="$report\n✅ 4. typecheck gruen"
else
  report="$report\n❌ 4. typecheck rot — erst reparieren, dann pushen"
  fails="$fails 4"
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # Ref-Loeschung ist immer erlaubt

  # ── 1. Verbotene Pfade in der ungepushten Historie ─────────────────────────
  hit=$(git log "$local_sha" --not --remotes=origin --format='%h %s' -- $(cat "$PATHS_FILE") 2>/dev/null | head -1)
  if [ -n "$hit" ]; then
    report="$report\n❌ 1. $local_ref: Historie beruehrt verbotene Pfade ($hit)"
    fails="$fails 1"
  else
    report="$report\n✅ 1. $local_ref: Historie ohne verbotene Pfade"
  fi

  # ── 2. Verbotene Pfade im gepushten Tree ───────────────────────────────────
  hit=$(git ls-tree -r --name-only "$local_sha" | grep -E "^($PATH_RE)(/|$)" | head -1)
  if [ -n "$hit" ]; then
    report="$report\n❌ 2. $local_ref: Tree enthaelt verbotenen Pfad: $hit"
    fails="$fails 2"
  else
    report="$report\n✅ 2. $local_ref: Tree ohne verbotene Pfade"
  fi

  # ── 3. Verbotene Inhalts-Muster im Delta (added lines + Commit-Messages) ───
  if [ "$remote_sha" != "$ZERO" ]; then
    base="$remote_sha"
  else
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
    [ -z "$base" ] && base="$EMPTY_TREE"
  fi
  hit_diff=$(git diff "$base" "$local_sha" -- . ':(exclude)scripts/git-hooks/public-push-policy.txt' 2>/dev/null \
             | grep '^+' | grep -iE -f "$PATTERNS_FILE" | head -1)
  hit_msg=$(git log --format=%B "$base..$local_sha" 2>/dev/null \
            | grep -iE -f "$PATTERNS_FILE" | head -1)
  if [ -n "$hit_diff" ] || [ -n "$hit_msg" ]; then
    report="$report\n❌ 3. $local_ref: Delta enthaelt verbotenes Inhalts-Muster: ${hit_diff}${hit_msg}"
    fails="$fails 3"
  else
    report="$report\n✅ 3. $local_ref: Delta ohne verbotene Inhalts-Muster$LOCAL_NOTE"
  fi

  # ── 5. Herkunft: Ref muss auf origin/main aufsetzen ────────────────────────
  if git merge-base --is-ancestor origin/main "$local_sha" 2>/dev/null; then
    report="$report\n✅ 5. $local_ref: basiert auf origin/main"
  else
    report="$report\n❌ 5. $local_ref: basiert NICHT auf origin/main — nur Branches ab origin/main pushen"
    fails="$fails 5"
  fi

  # ── 6. Kein Force-Push / Tag-Ueberschreiben auf main + Tags ────────────────
  case "$remote_ref" in
    refs/heads/main|refs/tags/*)
      if [ "$remote_sha" != "$ZERO" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        report="$report\n❌ 6. $remote_ref: nicht-fast-forward — Force-Push/Ueberschreiben blockiert"
        fails="$fails 6"
      else
        report="$report\n✅ 6. $remote_ref: fast-forward / neu"
      fi
      ;;
  esac
done

printf '%b\n' "$report" >&2
if [ -n "$fails" ]; then
  echo "pre-push: PUSH-CHECKLISTE nicht bestanden (Punkte:$fails) — Push blockiert." >&2
  echo "pre-push: Details in PUSH-CHECKLISTE.md. Bypass nur mit Owner-Go: git push --no-verify" >&2
  exit 1
fi
echo "pre-push: Push-Checkliste bestanden$LOCAL_NOTE."
exit 0
